# Copy to .env and adjust. All values are also overridable as env vars.

# Async SQLAlchemy URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:1212@localhost:5432/twatter

# JWT signing — use a long random string in any shared environment
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated list of allowed CORS origins ("*" allows all)
CORS_ORIGINS=*

# Verbose SQL logging
DEBUG=false
